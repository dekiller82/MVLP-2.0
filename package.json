{
  "name": "mvlp",
  "productName": "MVLP",
  "version": "2.0.0",
  "description": "MVLP connects iPixel-compatible LED panels to Multiviewer for F1 and Spotify, showing live track status and album art on your panel.",
  "author": "dekiller82",
  "license": "MIT",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "previews": "node scripts/make-previews.js",
    "circuits": "node scripts/build-circuits.js",
    "icons": "node scripts/make-icons.js",
    "dist": "npm run icons && electron-builder --publish never",
    "dist:win": "npm run icons && electron-builder --win --publish never",
    "dist:mac": "npm run icons && electron-builder --mac --publish never",
    "dist:linux": "npm run icons && electron-builder --linux --publish never",
    "dist:all": "npm run icons && electron-builder -mwl --publish never",
    "postinstall": "node scripts/make-icons.js"
  },
  "dependencies": {
    "@stoprocent/noble": "^2.8.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "gifuct-js": "^2.1.2",
    "jimp": "^0.22.12",
    "omggif": "^1.0.10",
    "rgbquant": "^1.1.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.mvlp.desktop",
    "productName": "MVLP",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@stoprocent/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "MVLP-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "MVLP-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "dekiller82",
      "artifactName": "MVLP-${version}-linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "dekiller82",
      "repo": "MVLP-2.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dekiller82/MVLP-2.0.git"
  },
  "homepage": "https://github.com/dekiller82/MVLP-2.0#readme",
  "bugs": {
    "url": "https://github.com/dekiller82/MVLP-2.0/issues"
  },
  "keywords": [
    "f1",
    "formula1",
    "multiviewer",
    "ipixel",
    "led-matrix",
    "bluetooth-le",
    "spotify",
    "electron"
  ]
}
